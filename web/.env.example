# Copiar a .env.local. Las variables VITE_* quedan dentro del bundle: nunca poner secretos aquí.

# Base de la API. En desarrollo, Vite redirige /api y /ws al backend (localhost:3000).
VITE_API_URL=/api/v1
VITE_WS_URL=/ws

# Key de Maps JavaScript API, restringida por dominio (HTTP referrer).
VITE_GOOGLE_MAPS_API_KEY=

# Celular de contacto para negocios y repartidores (9 dígitos, sin +51). Vacío: sin botón de WhatsApp.
VITE_SUPPORT_WHATSAPP=
