NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://apamuy:apamuy@localhost:5433/apamuy
# Orígenes permitidos por CORS, separados por coma (la app móvil no los necesita).
CORS_ORIGINS=http://localhost:3000
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookie del refresh token del panel web. none si panel y API están en sitios distintos (p. ej. dos *.up.railway.app).
AUTH_COOKIE_SAMESITE=strict
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# HMAC de los códigos OTP (mínimo 32 caracteres, distinto de JWT_ACCESS_SECRET).
OTP_SECRET=change-me-otp-change-me-otp-change-me-otp
# Solo fuera de producción: todos los códigos OTP son este valor (igual que el modo demo de la app).
OTP_DEV_CODE=123456

# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# Usa un Messaging Service (MG…) o un número remitente (+1…).
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=
# Saltos de proxy delante de la API (Railway: 1).
TRUST_PROXY=0
LOG_LEVEL=debug

# Push: log (desarrollo) o fcm. Con fcm, la cuenta de servicio de Firebase en base64:
#   base64 -w0 apamuy-firebase.json
PUSH_PROVIDER=log
FCM_SERVICE_ACCOUNT_BASE64=

# SMS: log (desarrollo) o twilio. Con twilio, la cuenta de servicio de Twilio:
SMS_PROVIDER=
SMS_COUNTRY_CODE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=  
TWILIO_MESSAGING_SERVICE_SID=

# Fotos: none (se pegan URLs) o r2. Con r2, un token de API de R2 con permiso de
# lectura y escritura sobre el bucket (ver README, "Fotos en Cloudflare R2").
STORAGE_PROVIDER=none
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
