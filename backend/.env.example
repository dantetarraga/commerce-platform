NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://chaski:chaski@localhost:5433/chaski
# Orígenes permitidos por CORS, separados por coma (la app móvil no los necesita).
CORS_ORIGINS=http://localhost:3000
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
# HMAC de los códigos OTP (mínimo 32 caracteres, distinto de JWT_ACCESS_SECRET).
OTP_SECRET=change-me-otp-change-me-otp-change-me-otp
# Solo fuera de producción: todos los códigos OTP son este valor (igual que el modo demo de la app).
OTP_DEV_CODE=123456
# log = el SMS va al log (desarrollo); twilio = envío real (obligatorio en producción).
SMS_PROVIDER=log
SMS_COUNTRY_CODE=+51
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# Usa un Messaging Service (MG…) o un número remitente (+1…).
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=
# Saltos de proxy delante de la API (Railway: 1).
TRUST_PROXY=0
LOG_LEVEL=debug
